diff --git a/mods/coordinator/detach.sh b/mods/coordinator/detach.sh
new file mode 100644
index 00000000..7a56c2e9
--- /dev/null
+++ b/mods/coordinator/detach.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# local: runs a coordinator script (restart.sh, close.sh, task.sh) detached from the menu that started it, and
+# says when it fails: its title and last error line go in data/coordinator/failed.txt, which mods/toasts shows.
+# Usage: detach.sh <title> <script> [args...]. bash 3.2 (macOS's /bin/bash) safe; macOS has no setsid.
+if [ -z "${HERDR_DETACHED:-}" ]; then
+  export HERDR_DETACHED=1
+  if command -v setsid >/dev/null 2>&1; then setsid -f bash "$0" "$@"; else set -m; nohup bash "$0" "$@" & fi >/dev/null 2>&1 </dev/null
+  exit 0
+fi
+title=$1
+shift
+err=$(bash "$@" 2>&1 >/dev/null) && exit 0
+f=${HERDR_APP_HOME:-$HOME/.config/herdr-app}/data/coordinator/failed.txt
+mkdir -p "${f%/*}"
+last=$(printf '%s\n' "$err" | grep -v '^[[:space:]]*$' | tail -n 1 | tr '\t' ' ')
+printf '%s\t%s\n' "$title" "${last:-It stopped before it finished.}" >>"$f"
diff --git a/mods/coordinator/restart.sh b/mods/coordinator/restart.sh
index b0ce4b94..af89b466 100755
--- a/mods/coordinator/restart.sh
+++ b/mods/coordinator/restart.sh
@@ -107,7 +107,7 @@ tpl=$HOME/.config/herdr-core/templates/assistant.md
 own=""
 [ -z "$argv" ] && [ "$role" = coordinator ] && own=$(awk '/^---[[:space:]]*$/ {f++; next} f == 1 && sub(/^command:[ \t]*/, "") {print; exit}' "$tpl" 2>/dev/null)
 if [ -n "${HERDR_RESTART_RESUME:-}" ] && [ -n "$argv" ]; then
-  mapfile -t cmd < <(jq -r '.[]' <<<"$argv")
+  cmd=(); while IFS= read -r a; do cmd+=("$a"); done < <(jq -r '.[]' <<<"$argv") # local: no mapfile in macOS's bash 3.2 (Herdr's PATH has /bin first)
   [ ${#cmd[@]} -gt 0 ] || exit 1
   new=$(hc run --bg --json --no-parent --cwd "$cwd" "${labels[@]}" --label "herdr.agent=$(basename "${cmd[0]}")" -- sh -c "$clean"' exec "$@"' herdr-clean "${cmd[@]}" | jq -r '.address // empty')
 elif [ -z "$argv" ] && [ "$role" = coordinator ] && [ -z "$own" ]; then
@@ -117,7 +117,7 @@ else
     own=${own#exec }
     line=$own key=$(basename "${own%% *}")
   else
-    mapfile -t cmd < <(jq -r '.[]' <<<"$argv")
+    cmd=(); while IFS= read -r a; do cmd+=("$a"); done < <(jq -r '.[]' <<<"$argv") # local: no mapfile in macOS's bash 3.2 (Herdr's PATH has /bin first)
     [ ${#cmd[@]} -gt 0 ] || exit 1
     key=$(basename "${cmd[0]}")
     # Codex runs its commands outside hc without --no-daemon.
@@ -144,7 +144,7 @@ else
     hc send "$new" "$msg" >/dev/null 2>&1
   fi
 fi
-[ -n "$new" ] || exit 1
+[ -n "$new" ] || { echo "Herdr didn't start the new agent." >&2; exit 1; } # local: says why (a toast shows it)
 hc kill "$old" >/dev/null 2>&1
 hc rm "$old" >/dev/null 2>&1
 echo "$new"
