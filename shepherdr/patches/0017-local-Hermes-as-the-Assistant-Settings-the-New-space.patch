+"""local: Hermes as the Assistant: herdr-task's argv_for turns Settings' coordinator choice into a hermes command,
+the same as core/hermes.js hermesArgv (test/hermes.test.js)."""
+import os
+import sys
+import unittest
+
+sys.dont_write_bytecode = True
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "mods", "tasks", "bin"))
+from herdr_task.settings import argv_for  # noqa: E402
+
+
+class HermesArgv(unittest.TestCase):
+    def test_each_perm(self):
+        self.assertEqual(argv_for({"agent": "hermes", "model": "default", "perm": "auto"}), ["hermes"])
+        self.assertEqual(argv_for({"agent": "hermes", "model": "default", "perm": "full"}), ["hermes", "--yolo"])
+        self.assertEqual(argv_for({"agent": "hermes", "model": "qwen/qwen3.7-max", "perm": "auto"}), ["hermes", "-m", "qwen/qwen3.7-max"])
+        self.assertEqual(argv_for({"agent": "hermes"}), ["hermes"])
+
+
+if __name__ == "__main__":
+    unittest.main()
