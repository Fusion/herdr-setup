+// What a worker or reviewer is offered: the same, without Hermes.
+export const withoutHermes = (data) => (data?.menus?.hermes ? { ...data, menus: Object.fromEntries(Object.entries(data.menus).filter(([k]) => k !== "hermes")) } : data);
