+// local: Hermes as the Assistant (HS-1): what Settings offers and the command it starts.
+import { argvFor, menuFor, current, NAMES } from "../core/agents.js";
+import { withoutHermes } from "../core/hermes.js";
+
+test("a Hermes Assistant starts on its default model with the allowlist (Auto), or --yolo for Full access", () => {
+  expect(argvFor({ agent: "hermes", model: "default", perm: "auto" }, { agent: null, argv: [] }).argv).toEqual(["hermes"]);
+  expect(argvFor({ agent: "hermes", model: "default", perm: "full" }, { agent: null, argv: [] }).argv).toEqual(["hermes", "--yolo"]);
+  expect(argvFor({ agent: "hermes", model: "qwen/qwen3.7-max", perm: "auto" }, { agent: "hermes", argv: ["hermes"] }))
+    .toEqual({ argv: ["hermes", "-m", "qwen/qwen3.7-max"], resume: false, base: ["hermes", "-m", "qwen/qwen3.7-max"] });
+  expect(current("hermes", ["python", "hermes", "-m", "x", "--yolo"], {})).toMatchObject({ agent: "hermes", model: "x", perm: "full" });
+  expect(current("hermes", [], {})).toMatchObject({ agent: "hermes", model: "default", perm: "auto" });
+  const m = menuFor("hermes", { model: "claude-opus-5-5[1m]" });
+  expect(m.name).toBe(NAMES.hermes);
+  expect(m.models[0]).toMatchObject({ id: "default", name: "Default (claude-opus-5-5[1m])" });
+  expect(m.perms.map((p) => p.id)).toEqual(["auto", "full"]);
+  // workers and the reviewer aren't offered it
+  expect(Object.keys(withoutHermes({ menus: { claude: {}, codex: {}, hermes: m } }).menus)).toEqual(["claude", "codex"]);
+});
