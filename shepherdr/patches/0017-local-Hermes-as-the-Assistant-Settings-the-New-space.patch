+// Whether Hermes's screen shows these questions' picker at its first question, none answered yet:
+//   │ 2 questions │  │ ▸ Color? │  │   ❯ 1. Red (Recommended) │ ...  (box borders and wrapping taken out).
+export function hermesOnScreen(screen, questions) {
+  const s = String(screen ?? "").replace(/[│╭╮╰╯─]/g, " ").replace(/\s+/g, " ");
+  const q = questions?.[0], n = questions?.length ?? 0;
+  if (!q || !s.includes("needs your input")) return false;
+  const one = (w) => s.includes(String(w).replace(/\s+/g, " ").trim());
+  return one(`${n} question${n === 1 ? "" : "s"}`) && one(`▸ ${q.text}`) && !s.includes(`✓ ${q.text}`) && q.choices.every((c) => one(c.label));
