+        .filter(Boolean).join("\n\n");
+      // As Codex's (core/asks.js codexQuestions): the chat's question card answers them on Hermes's screen.
+      const questions = qs.map((q) => ({ text: String(q?.question ?? ""), header: "",
+        choices: (Array.isArray(q?.choices) ? q.choices : []).map((c) => ({ label: String(c) })).filter((c) => c.label) })).filter((q) => q.text);
+      if (text) conv.asked(id, { kind: "ask", id: `q${off}`, text, ...(questions.length ? { questions } : {}) });
+      conv.open.set(id, "Asking you something");
+      conv.doing = "Asking you something";
+      continue;
+    }
+    const st = hermesStep(name, a);
+    st.at = at || Date.now();
+    conv.step(id, off, st, name === "delegate_task" ? id : null);
+    if (name === "terminal") conv.sent(String(a.command ?? ""), off, at);
+  }
+  if (!said && !l.tool_calls?.length && l.thinking && !conv.open.size) conv.doing = "Thinking";
+  // A reply that ends the turn: nothing is running any more.
+  if (l.finish === "stop" && !l.tool_calls?.length) { conv.open.clear(); conv.waits.clear(); conv.waiting = false; conv.doing = null; }
+}
+
+// ---- Hermes as the Assistant (HS-1): Settings and the New space dialog offer it for the Assistant only (workers keep
+// Claude Code and Codex); core/agents.js and lib/settings.js hook these in.
+export const HERMES_NAME = "Hermes";
+// Auto: Hermes asks only for a command its guards find risky, and herdr-setup's bin/apply allowlists Herdr's own
+// (herdr-task, hc, herdr-artifact, herdr-secret, read-only git) in ~/.hermes/config.yaml, so those never stop it: the
+// chat has no approval cards for Hermes. Full access: --yolo.
+export const HERMES_PERMS = [{ id: "auto", label: "Auto" }, { id: "full", label: "Full access" }];
+// Its model: Hermes's own default (config.yaml model.default, read by core/agents.js DEFAULTS), or one typed by id (-m).
+export function hermesMenu(dflt, current = null) {
