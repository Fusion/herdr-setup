diff --git a/mods/coordinator/run-or-toast.sh b/mods/coordinator/run-or-toast.sh
new file mode 100644
index 00000000..0278d609
--- /dev/null
+++ b/mods/coordinator/run-or-toast.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+# local: runs a coordinator script (restart.sh, close.sh, task.sh) that lib/coordinator.js started detached (DETACH),
+# and says when it fails: its title and last error line go in data/coordinator/failed.txt, which mods/toasts shows.
+# Usage: run-or-toast.sh <title> <script> [args...]. bash 3.2 (macOS's /bin/bash) safe.
+title=$1
+shift
+err=$(bash "$@" 2>&1 >/dev/null) && exit 0
+f=${HERDR_APP_HOME:-$HOME/.config/herdr-app}/data/coordinator/failed.txt
+mkdir -p "${f%/*}"
+last=$(printf '%s\n' "$err" | grep -v '^[[:space:]]*$' | tail -n 1 | tr '\t' ' ')
+printf '%s\t%s\n' "$title" "${last:-It stopped before it finished.}" >>"$f"
