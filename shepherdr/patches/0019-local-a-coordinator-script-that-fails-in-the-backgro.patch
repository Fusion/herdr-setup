diff --git a/lib/coordinator.js b/lib/coordinator.js
index 254be271..045ab01a 100644
--- a/lib/coordinator.js
+++ b/lib/coordinator.js
@@ -95,8 +95,11 @@ export function entryFor(k, known) {
 // The helper scripts run detached: the menu that starts one closes at once. macOS has no setsid (#736): there the
 // script runs in a job of its own (set -m) under nohup, so it outlives the menu all the same.
 export const DETACH = 'if command -v setsid >/dev/null 2>&1; then setsid -f bash "$0" "$@"; else set -m; nohup bash "$0" "$@" & fi >/dev/null 2>&1 </dev/null';
+// local: through run-or-toast.sh, so a failure becomes a toast (mods/toasts reads data/coordinator/failed.txt)
+const FAILED = { restart: "The agent didn't restart", close: "The Assistant didn't close", task: "The task's agent didn't switch" };
 function script(name, args) {
-  return exec("bash", ["-c", DETACH, `${appHome()}/mods/coordinator/${name}.sh`, ...args]);
+  const dir = `${appHome()}/mods/coordinator`; // local: run-or-toast.sh
+  return exec("bash", ["-c", DETACH, `${dir}/run-or-toast.sh`, FAILED[name] ?? `${name} failed`, `${dir}/${name}.sh`, ...args]); // local: run-or-toast.sh
 }
 
