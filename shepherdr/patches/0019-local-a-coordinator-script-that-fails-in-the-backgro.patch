 import { View, div, svg } from "gpui-kit";
 import { v_flex, h_flex } from "gpui-base";
-import { placement, run, shared, setShared, theme } from "herdr";
+import { placement, run, shared, setShared, theme, appHome, readTextFile, writeTextFile } from "herdr"; // local: appHome, readTextFile, writeTextFile
 import { note } from "./usage.js";
-import { TOASTS, TEXT, RADIUS, red, amber, green } from "./ui.js";
+import { TOASTS, TEXT, RADIUS, red, amber, green, toast } from "./ui.js"; // local: toast
 // How many, how wide, how long and in which color: core/toasts.js, shared with the web app's toasts.
 import { SHOWN, WIDTH, LINES, BODY_MAX, tone, clip, unexpired } from "./core/toasts.js";
 
@@ -32,6 +32,18 @@ export default class Toasts extends View {
       const left = unexpired(list);
       if (left.length !== list.length) setShared(TOASTS, left);
     });
+    // local: a coordinator script that failed in the background (mods/coordinator/run-or-toast.sh): "title\tbody" lines
+    cx.timer.every(3000, (cx) => cx.spawn(async () => {
+      const f = `${appHome()}/data/coordinator/failed.txt`;
+      const text = await readTextFile(f).catch(() => null);
+      if (!text) return;
+      // Only what was read is taken: a line written meanwhile waits for the next round.
+      if (!(await writeTextFile(f, "", text).then(() => true, () => false))) return;
+      for (const l of text.split("\n").filter(Boolean)) {
+        const [title, body] = l.split("\t");
+        toast({ title, body: body ?? "", level: "error" });
+      }
+    }));
   }
 
