diff --git a/mods/coordinator/hermes-env.sh b/mods/coordinator/hermes-env.sh
new file mode 100644
index 00000000..facf7dd1
--- /dev/null
+++ b/mods/coordinator/hermes-env.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# local: what a Hermes Assistant's first message starts with: its terminal's Herdr variables as a ready-to-run export
+# line. Hermes runs its shell commands in its long-lived gateway, which never had this terminal's HC_TERMINAL_ID,
+# HC_TERMINAL_SOCKET and HC_SCOPE (HC_SCOPE differs per terminal), so hc get/--parent/hc wait --children break
+# without them. They are read from the terminal's own process (the hermes CLI Herdr started), once it runs.
+# Usage: hermes-env.sh <terminal>. Prints nothing when its process or the variables aren't found.
+# bash 3.2 (macOS's /bin/bash) safe.
+pid=$(hc get "$1" --json 2>/dev/null | jq -r '.foreground.pid // empty')
+[ -n "$pid" ] || exit 0
+if [ -r "/proc/$pid/environ" ]; then
+  envs=$(tr '\0' '\n' <"/proc/$pid/environ")
+else
+  envs=$(ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n')
+fi
+line=""
+for k in HC_TERMINAL_ID HC_TERMINAL_SOCKET HC_SCOPE; do
+  v=$(printf '%s\n' "$envs" | grep -m1 "^$k=" | cut -d= -f2-)
+  [ -n "$v" ] || exit 0
+  line+=" $k=$(printf '%q' "$v")"
+done
+printf '%s\n' "Your shell commands run in Hermes's gateway, without this terminal's Herdr variables, so hc and herdr-task can't tell who you are. Put this export line first in every shell command that runs hc or herdr-task (each command may get a fresh shell):" \
+  "" '```sh' "export$line" '```'
diff --git a/mods/coordinator/restart.sh b/mods/coordinator/restart.sh
index d084f5f7..4469b35d 100755
--- a/mods/coordinator/restart.sh
+++ b/mods/coordinator/restart.sh
@@ -138,10 +138,18 @@ else
   one=herdr-handoff-$$
   file=$HOME/.config/herdr-core/templates/$one.md
   { printf -- '---\nname: %s\ndescription: A one-off Herdr handoff, removed after use.\ncommand: %s\n---\n' "$one" "$clean exec $line"
-    printf '%s\n' "$msg"; } >"$file"
+    [ "$key" = hermes ] || printf '%s\n' "$msg"; } >"$file" # local: Hermes's message is sent below, once it runs
   out=$(hc run --bg --json --no-parent --cwd "$cwd" "${labels[@]}" --label "herdr.agent=$key" "$one")
   rm -f "$file"
   new=$(jq -r '.address // empty' <<<"$out")
+  # local: Hermes runs its commands without this terminal's HC_* variables: its first message starts with them as an
+  # export line, read from its own process once it runs (hermes-env.sh), then the instructions and handoff.
+  if [ -n "$new" ] && [ "$key" = hermes ]; then
+    hc wait "$new" --timeout 90 >/dev/null 2>&1
+    pre=$(bash "${HERDR_APP_HOME:-$HOME/.config/herdr-app}/mods/coordinator/hermes-env.sh" "$new")
+    [ -n "$pre" ] && msg="$pre"$'\n\n'"$msg"
+    out='{"first_message":{"sent":false}}'
+  fi
   # Some agents (Codex's animated start) never settle for hc: send once it reports a status.
   if [ -n "$new" ] && [ "$(jq -r '.first_message.sent' <<<"$out")" = false ]; then
     hc wait "$new" --timeout 90 >/dev/null 2>&1
diff --git a/test/hermes-env.test.js b/test/hermes-env.test.js
new file mode 100644
index 00000000..4d03669d
--- /dev/null
+++ b/test/hermes-env.test.js
@@ -0,0 +1,41 @@
+// local: a Hermes Assistant's first message starts with its terminal's HC_* variables as an export line
+// (mods/coordinator/hermes-env.sh), read from the terminal's own process: Hermes runs its commands in its gateway.
+// The stand-in agent is bun, not /bin/sleep: macOS hides a system binary's environment from ps.
+import { test, expect } from "bun:test";
+import { mkdtempSync, writeFileSync, chmodSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+
+const SCRIPT = join(import.meta.dir, "..", "mods", "coordinator", "hermes-env.sh");
+
+// A stand-in hc whose `get` names `pid` as the terminal's foreground process.
+function fakeHc(pid) {
+  const bin = mkdtempSync(join(tmpdir(), "hermes-env-"));
+  writeFileSync(join(bin, "hc"), `#!/bin/sh\n[ "$1" = get ] && echo '{"foreground":{"pid":${pid ?? "null"}}}'\n`);
+  chmodSync(join(bin, "hc"), 0o755);
+  return { ...process.env, PATH: `${bin}:${process.env.PATH}` };
+}
+const run = (env) => Bun.spawnSync(["/bin/bash", SCRIPT, "t9"], { env }).stdout.toString();
+
+test("the export line carries the terminal's own HC_TERMINAL_ID, HC_TERMINAL_SOCKET and HC_SCOPE", () => {
+  const agent = Bun.spawn([process.execPath, "-e", "setTimeout(() => {}, 30000)"], { env: { ...process.env, HC_TERMINAL_ID: "t9", HC_TERMINAL_SOCKET: "/tmp/herdr-core/default.sock", HC_SCOPE: "123-abc" } });
+  try {
+    Bun.sleepSync(200);
+    const out = run(fakeHc(agent.pid));
+    expect(out).toContain("Put this export line first in every shell command that runs hc or herdr-task");
+    expect(out).toContain("```sh\nexport HC_TERMINAL_ID=t9 HC_TERMINAL_SOCKET=/tmp/herdr-core/default.sock HC_SCOPE=123-abc\n```");
+  } finally {
+    agent.kill();
+  }
+});
+
+test("nothing when the process or one of the variables isn't found", () => {
+  expect(run(fakeHc(null))).toBe("");
+  const bare = Bun.spawn([process.execPath, "-e", "setTimeout(() => {}, 30000)"], { env: { PATH: process.env.PATH, HC_TERMINAL_ID: "t9" } });
+  try {
+    Bun.sleepSync(200);
+    expect(run(fakeHc(bare.pid))).toBe("");
+  } finally {
+    bare.kill();
+  }
+});
