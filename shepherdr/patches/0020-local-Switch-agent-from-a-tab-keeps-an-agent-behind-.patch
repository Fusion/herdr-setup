From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris F Ravenscroft <chris@voilaweb.com>
Date: Thu, 12 Nov 2026 16:31:23 -0800
Subject: [PATCH 20/20] local: Switch agent from a tab keeps an agent behind
 its chat (its slot's pane when herdr.chat was lost)

---
 lib/coordinator.js                     | 20 +++++++++++++++++---
 mods/coordinator/coordinator.js        | 20 +++++++++++++++++---
 mods/menu-tasks/coordinator.js         | 20 +++++++++++++++++---
 mods/new-menu-tasks/coordinator.js     | 20 +++++++++++++++++---
 mods/newspace/coordinator.js           | 20 +++++++++++++++++---
 mods/shepherdr-settings/coordinator.js | 20 +++++++++++++++++---
 mods/spaces-chat/coordinator.js        | 20 +++++++++++++++++---
 mods/tabs-tasks/coordinator.js         | 20 +++++++++++++++++---
 mods/tasks/coordinator.js              | 20 +++++++++++++++++---
 9 files changed, 153 insertions(+), 27 deletions(-)

diff --git a/lib/coordinator.js b/lib/coordinator.js
index 045ab01a..77647a20 100644
--- a/lib/coordinator.js
+++ b/lib/coordinator.js
@@ -97,9 +97,9 @@ export function entryFor(k, known) {
 export const DETACH = 'if command -v setsid >/dev/null 2>&1; then setsid -f bash "$0" "$@"; else set -m; nohup bash "$0" "$@" & fi >/dev/null 2>&1 </dev/null';
 // local: through run-or-toast.sh, so a failure becomes a toast (mods/toasts reads data/coordinator/failed.txt)
 const FAILED = { restart: "The agent didn't restart", close: "The Assistant didn't close", task: "The task's agent didn't switch" };
-function script(name, args) {
+function script(name, args, env = []) { // local: env ("NAME=value"s) for the script
   const dir = `${appHome()}/mods/coordinator`; // local: run-or-toast.sh
-  return exec("bash", ["-c", DETACH, `${dir}/run-or-toast.sh`, FAILED[name] ?? `${name} failed`, `${dir}/${name}.sh`, ...args]); // local: run-or-toast.sh
+  return exec("env", [...env, "bash", "-c", DETACH, `${dir}/run-or-toast.sh`, FAILED[name] ?? `${name} failed`, `${dir}/${name}.sh`, ...args]); // local: run-or-toast.sh, env
 }
 
 // Where a space's coordinator works: its focused (else first) terminal's folder.
@@ -480,7 +480,21 @@ export const switchTask = (k, agentKey) =>
 
 // Restarts the agent `k` in its tab: with `argv`, as that agent; without, as it was
 // (a coordinator from the template again, so edited instructions apply).
-export const restartAgent = (k, argv) => script("restart", argv ? [k.address, JSON.stringify(argv)] : [k.address]);
+// local: an agent behind a chat restarts behind the same chat, as the chat's own picker does (lib/agent.js restart):
+// its herdr.chat label, else its Assistant slot's pane, else the one chat pane in its Assistant tab (an Assistant
+// whose herdr.chat was lost started its replacement as a pane in the tab, and the chat lost it).
+function chatOf(k) {
+  const l = k?.labels ?? {};
+  const chats = panes().filter((p) => p.mod === "chat");
+  const ok = (p) => (p && chats.some((q) => q.pane === p) ? p : null);
+  const tab = l["herdr.coordinator.tab"];
+  const inTab = tab ? chats.filter((p) => String(p.tab).split("/").pop() === tab) : [];
+  return ok(chatPane(k)) ?? ok(shared("coordinator.slots")?.[l["herdr.chat.slot"]]?.pane) ?? (inTab.length === 1 ? inTab[0].pane : null);
+}
+export const restartAgent = (k, argv) => { // local: chatOf
+  const chat = chatOf(k);
+  return script("restart", argv ? [k.address, JSON.stringify(argv)] : [k.address], chat ? [`HERDR_RESTART_CHAT=${chatLabel(chat)}`] : []);
+};
 
 // Closes a tab. A coordinator with live workers asks first; a space's last tab closes the space,
 // so it asks as Close space does (our confirm, not Herdr's).
