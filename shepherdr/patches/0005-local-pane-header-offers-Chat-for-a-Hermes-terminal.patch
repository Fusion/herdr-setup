+const chatty = (p) => Boolean(p?.terminal) && (["claude-code", "codex"].includes(p.app) || ["claude", "codex"].includes(p.program?.key) || hermesSeen.get(p.terminal)?.is === true);
+
+// local: Hermes reports nothing to Herdr and runs as python, so its pane shows as python: what runs is asked
+// of core (hc get: the foreground's argv), at most every 4 s per terminal, when the header draws.
+const hermesSeen = new Map(); // terminal -> { is, at }
+function lookHermes(p, cx) {
+  if (!p?.terminal || ["claude", "codex"].includes(p.program?.key)) return;
+  const was = hermesSeen.get(p.terminal);
+  if (was && Date.now() - was.at < 4000) return;
+  hermesSeen.set(p.terminal, { is: was?.is ?? false, at: Date.now() });
+  cx.spawn(async (cx) => {
+    let is = false;
+    try { is = isHermes(JSON.parse((await hc(["get", p.terminal, "--json"])).stdout)); } catch {}
+    hermesSeen.set(p.terminal, { is, at: Date.now() });
+    if (is !== (was?.is ?? false)) cx.notify();
+  });
+}
 
