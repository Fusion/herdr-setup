+// local: Hermes in the chat (core/hermes.js): LOG reads a session from a state.db, the conversation shows it.
+import { test, expect } from "bun:test";
+import { Database } from "bun:sqlite";
+import { mkdtempSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import { LOG, Conversation, records, resultText } from "../core/chat-log.js";
+import { kindOf } from "../core/chat-reader.js";
+
+const sh = (args) => Bun.spawnSync(["sh", "-c", LOG, "log", ...args]).stdout.toString();
+
+test("a Hermes session reads as a chat: words, a tools row with its output, the reply that ends the turn", () => {
+  const db = join(mkdtempSync(join(tmpdir(), "hermes-")), "state.db");
+  const d = new Database(db);
+  d.run("create table messages (id integer primary key, session_id text, role text, content text, tool_call_id text, tool_calls text, tool_name text, timestamp real, finish_reason text, reasoning text, display_kind text, active integer default 1)");
+  const add = (role, content, extra = {}) => d.run("insert into messages (session_id, role, content, tool_call_id, tool_calls, tool_name, timestamp, finish_reason, display_kind) values (?,?,?,?,?,?,?,?,?)",
+    ["s1", role, content, extra.id ?? null, extra.calls ? JSON.stringify(extra.calls) : null, extra.tool ?? null, 1794200000, extra.finish ?? null, extra.kind ?? null]);
+  add("user", "run echo hi");
+  add("assistant", "", { calls: [{ id: "c1", function: { name: "terminal", arguments: JSON.stringify({ command: "echo hi" }) } }], finish: "tool_calls" });
+  add("tool", JSON.stringify({ output: "hi", exit_code: 0 }), { id: "c1", tool: "terminal" });
+  add("user", "background note", { kind: "internal_notification" });
+  add("assistant", "It printed hi.", { finish: "stop" });
+  d.close();
+
+  const { head, records: recs } = records(sh(["page", `${db}#s1`, "999999999999999", "200"]));
+  expect(head).toEqual(["P", "0", "6"]);
+  const conv = new Conversation("hermes");
+  conv.feed(recs);
+  expect(conv.items.map((i) => i.kind)).toEqual(["user", "tools", "agent"]);
+  expect(conv.items[1].steps[0]).toMatchObject({ kind: "run", line: "Ran echo hi", out: 3 });
+  expect(conv.doing).toBe(null);
+
+  const out = sh(["results", `${db}#s1`, "3"]).split("\x1e")[1];
+  expect(resultText(out.slice(out.indexOf("\n") + 1), "c1")).toBe("hi");
+  expect(records(sh(["tail", `${db}#s1`, "6"])).head).toEqual(["T", "6", "6", "6"]);
+});
+
+test("a terminal running Hermes is a Hermes chat", () => {
+  expect(kindOf({ foreground: { name: "python3.14", argv: ["python3", "-c", "sys.path.insert(0, '/Users/x/.hermes/hermes-agent')"] } })).toBe("hermes");
+  expect(kindOf({ foreground: { name: "zsh", argv: ["zsh"] } })).toBe(null);
+});
