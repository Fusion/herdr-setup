From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris F Ravenscroft <chris@voilaweb.com>
Date: Sun, 8 Nov 2026 21:02:53 -0800
Subject: [PATCH 03/19] local: sidebar row shows a breathing dot while a
 space's agent works

---
 mods/spaces-chat/main.js | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/mods/spaces-chat/main.js b/mods/spaces-chat/main.js
index 01e3ae44..7f9db262 100644
--- a/mods/spaces-chat/main.js
+++ b/mods/spaces-chat/main.js
@@ -740,6 +740,8 @@ export default class Spaces extends View {
             .when(quiet && Boolean(iconOf(w.id)), (el) => el.opacity(0.5)).child(iconOf(w.id) ?? "#")))
           .child(nameText(name, fresh, quiet ? t.dim : w.active ? t.foreground : t.muted, t))
           .when(Boolean(this.pilotMark(w, t)), (el) => el.child(this.pilotMark(w, t)))
+          // local: an agent in this space is working (Herdr's space status): a small breathing dot.
+          .when(w.status === "working", (el) => el.child(div().id(`working-${w.id}`).size(6).rounded(3).flex_none().bg(t.working).loop("opacity", { from: 0.35, to: 1, period: 1200 })))
           .child(g ? this.gitTail(g, tree, name, t, label) : h_flex().flex_1().min_w(0).justify_end().text_size(TEXT.label).text_color(t.dim)
             .when(Boolean(label), (el) => el.child(div().min_w(0).truncate().child(label))))
           .when(quiet, (el) => el.child(svg("mods/spaces-chat/bell-off.svg").size(13).flex_none().text_color(t.dim)))
