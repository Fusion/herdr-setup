From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris F Ravenscroft <chris@voilaweb.com>
Date: Thu, 12 Nov 2026 15:44:02 -0800
Subject: [PATCH 18/20] local: the chat's agent picker offers Hermes to the
 Assistant (upstream now starts the tab's Switch agent without setsid)

---
 mods/chat/main.js | 13 +++++++------
 1 file changed, 7 insertions(+), 6 deletions(-)

diff --git a/mods/chat/main.js b/mods/chat/main.js
index f1dc11a5..fbc75dd5 100644
--- a/mods/chat/main.js
+++ b/mods/chat/main.js
@@ -2699,12 +2699,12 @@ export default class Chat extends View {
       try {
         const stale = !this.pickCache || Date.now() - this.pickCache.at > 60000 || this.pickCache.machine !== this.machine;
         if (stale) {
-          const [claude, codex, known] = await Promise.all([agent.defaults("claude", this.machine), agent.defaults("codex", this.machine),
-            knownAgents({ on: this.machine }).catch(() => [])]);
+          const [claude, codex, hermes, known] = await Promise.all([agent.defaults("claude", this.machine), agent.defaults("codex", this.machine), // local: hermes
+            agent.defaults("hermes", this.machine), knownAgents({ on: this.machine }).catch(() => [])]); // local: hermes
           const prog = (key) => known.find((a) => a.key === key || (a.run ?? [])[0] === key);
-          this.pickCache = { at: Date.now(), machine: this.machine, dflts: { claude, codex },
-            icons: Object.fromEntries(["claude", "codex"].map((k) => [k, { icon: prog(k)?.icon ?? null, tint: Boolean(prog(k)?.tint) }])),
-            installed: Object.fromEntries(["claude", "codex"].map((k) => [k, prog(k) ? prog(k).installed !== false : true])) };
+          this.pickCache = { at: Date.now(), machine: this.machine, dflts: { claude, codex, hermes }, // local: hermes
+            icons: Object.fromEntries(["claude", "codex", "hermes"].map((k) => [k, { icon: prog(k)?.icon ?? null, tint: Boolean(prog(k)?.tint) }])), // local: hermes
+            installed: Object.fromEntries(["claude", "codex", "hermes"].map((k) => [k, prog(k) ? prog(k).installed !== false : k !== "hermes"])) }; // local: Hermes only when Herdr knows it
         }
         const { dflts, icons, installed } = this.pickCache;
         if (this.kind) dflts[this.kind] = this.dflt ?? dflts[this.kind];
@@ -2712,7 +2712,8 @@ export default class Chat extends View {
         const offline = this.machine && !online(this.machine) ? this.machine : null;
         const currentRow = agent.rowFor(c.agent, c);
         // Installed agents only (and always the one running).
-        const menus = Object.fromEntries(["claude", "codex"].filter((k) => k === c.agent || installed[k])
+        // local: Hermes only for the Assistant (workers keep Claude Code and Codex)
+        const menus = Object.fromEntries(["claude", "codex", "hermes"].filter((k) => k === c.agent || (installed[k] && (k !== "hermes" || this.assistant())))
           .map((k) => [k, agent.menuFor(k, dflts[k], k === c.agent ? currentRow : null)]));
         // As tall as the menu can get (chat-models' sizes): border and padding, another machine's
         // offline line, agent tabs, search, the list (it scrolls past 8 rows), separator, Reasoning header
