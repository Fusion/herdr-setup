 core/hermes.js                | 33 +++++++++++++++++++++++++++++++--
 mods/chat/core/hermes.js      | 33 +++++++++++++++++++++++++++++++--
 mods/chat/main.js             | 12 +++++++-----
 mods/pane-chat/core/hermes.js | 33 +++++++++++++++++++++++++++++++--
 test/hermes.test.js           | 25 +++++++++++++++++++++++++
 5 files changed, 125 insertions(+), 11 deletions(-)

diff --git a/core/hermes.js b/core/hermes.js
index d37c8f83..6037711f 100644
--- a/core/hermes.js
+++ b/core/hermes.js
@@ -156,6 +156,32 @@ export function hermesStep(name, a = {}) {
   return { kind: "tool", line: `Used ${name}`, doing: `Using ${name}` };
 }
 
+// Whether Hermes's screen shows these questions' picker at its first question, none answered yet:
+//   │ 2 questions │  │ ▸ Color? │  │   ❯ 1. Red (Recommended) │ ...  (box borders and wrapping taken out).
+export function hermesOnScreen(screen, questions) {
+  const s = String(screen ?? "").replace(/[│╭╮╰╯─]/g, " ").replace(/\s+/g, " ");
+  const q = questions?.[0], n = questions?.length ?? 0;
+  if (!q || !s.includes("needs your input")) return false;
+  const one = (w) => s.includes(String(w).replace(/\s+/g, " ").trim());
+  return one(`${n} question${n === 1 ? "" : "s"}`) && one(`▸ ${q.text}`) && !s.includes(`✓ ${q.text}`) && q.choices.every((c) => one(c.label));
+}
+
+// The keys that answer them on that picker: a choice's number answers its question and goes to the next (the last
+// one submits); "Other" is the number after the choices, then the words and Enter. -> [{ keys } | { paste }], or null.
+export function hermesSteps(questions, answers) {
+  if (!Array.isArray(answers) || answers.length !== questions.length) return null;
+  const steps = [];
+  for (const [i, q] of questions.entries()) {
+    const said = String(answers[i] ?? "").trim();
+    if (!said) return null;
+    const k = q.choices.findIndex((c) => c.label === said || c.label.replace(/\s*\(recommended\)\s*$/i, "") === said);
+    const pick = (n) => (n < 9 ? [String(n + 1)] : [...Array(n).fill("down"), "enter"]);
+    if (k >= 0) steps.push({ keys: pick(k) });
+    else steps.push({ keys: pick(q.choices.length) }, { paste: said });
+  }
+  return steps;
+}
+
 // Hermes's own rows that aren't the conversation (notices to the agent, model switches, hidden turns).
 const QUIET = new Set(["hidden", "internal_notification", "async_delegation_complete", "process_complete", "model_switch"]);
 
@@ -195,8 +221,11 @@ export function hermesFeed(conv, l, off, cleanUser) {
       // Hermes 0.23: { questions: [{ question, choices }] }; before: { question, choices }.
       const qs = Array.isArray(a.questions) ? a.questions : [a];
       const text = qs.map((q) => [q?.question, ...(Array.isArray(q?.choices) ? q.choices.map((o) => `- ${o}`) : [])].filter(Boolean).join("\n"))
-        .filter(Boolean).join("\n\n") + (qs.length ? "\n\nAnswer it in Hermes's terminal." : "");
-      if (text) conv.asked(id, { kind: "ask", id: `q${off}`, text });
+        .filter(Boolean).join("\n\n");
+      // As Codex's (core/asks.js codexQuestions): the chat's question card answers them on Hermes's screen.
+      const questions = qs.map((q) => ({ text: String(q?.question ?? ""), header: "",
+        choices: (Array.isArray(q?.choices) ? q.choices : []).map((c) => ({ label: String(c) })).filter((c) => c.label) })).filter((q) => q.text);
+      if (text) conv.asked(id, { kind: "ask", id: `q${off}`, text, ...(questions.length ? { questions } : {}) });
       conv.open.set(id, "Asking you something");
       conv.doing = "Asking you something";
       continue;
