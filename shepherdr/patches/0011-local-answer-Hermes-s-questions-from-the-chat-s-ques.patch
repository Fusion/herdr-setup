diff --git a/test/hermes.test.js b/test/hermes.test.js
index 8c359edd..4c218fbe 100644
--- a/test/hermes.test.js
+++ b/test/hermes.test.js
@@ -39,3 +39,28 @@ test("a terminal running Hermes is a Hermes chat", () => {
   expect(kindOf({ foreground: { name: "python3.14", argv: ["python3", "-c", "sys.path.insert(0, '/Users/x/.hermes/hermes-agent')"] } })).toBe("hermes");
   expect(kindOf({ foreground: { name: "zsh", argv: ["zsh"] } })).toBe(null);
 });
+
+import { hermesOnScreen, hermesSteps } from "../core/hermes.js";
+
+const PICKER = `╭─ Hermes Agent needs your input ────────────────╮
+│ 2 questions                                    │
+│ ▸ Color?                                       │
+│   ❯ 1. Red (Recommended)                       │
+│     2. Blue                                    │
+│     3. Other (type your answer)                │
+│ · Size?                                        │
+╰────────────────────────────────────────────────╯
+  ↑/↓ to select, Enter to lock, Tab next question  (599s)`;
+const QS = [{ text: "Color?", choices: [{ label: "Red" }, { label: "Blue" }] }, { text: "Size?", choices: [{ label: "Small" }, { label: "Large" }] }];
+
+test("Hermes's question picker is recognised only while it waits on the first question", () => {
+  expect(hermesOnScreen(PICKER, QS)).toBe(true);
+  expect(hermesOnScreen(PICKER.replace("▸ Color?", "✓ Color?"), QS)).toBe(false);
+  expect(hermesOnScreen("❯ ready", QS)).toBe(false);
+  expect(hermesOnScreen(PICKER, [QS[0]])).toBe(false); // says 2 questions
+});
+
+test("answers become Hermes's keys: a choice's number, Other's number then the words", () => {
+  expect(hermesSteps(QS, ["Blue", "Medium please"])).toEqual([{ keys: ["2"] }, { keys: ["3"] }, { paste: "Medium please" }]);
+  expect(hermesSteps(QS, ["Red"])).toBe(null);
+});
