#!/usr/bin/env bash
# Put this setup on a machine, or bring it up to date with a new Shepherdr / Hermes:
#   1. Shepherdr checkout ($SHEPHERDR_DIR, default ~/Projects/shepherdr; cloned if missing):
#      no `local` branch yet -> made from shepherdr/BASE with shepherdr/patches (git am -3);
#      then `local` is rebased onto the latest upstream main (git rebase).
#      A conflict stops here: fix it, `git am --continue` / `git rebase --continue`, run apply again.
#   2. Shepherdr's own checks and installer, then the two fixes its installer needs every time.
#   3. The Hermes plugin and skill, when Hermes is installed.
# Flags: --no-pull (don't fetch upstream), --no-rebase (stay on the upstream the branch is on;
# a new machine stays on shepherdr/BASE), --no-install (stop after step 1).
set -euo pipefail
KIT=$(cd "$(dirname "$0")/.." && pwd)
SRC=${SHEPHERDR_DIR:-$HOME/Projects/shepherdr}
UPSTREAM=https://github.com/eliasstravik/shepherdr.git
CFG=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
pull=1 install=1 rebase=1
for a in "$@"; do case $a in --no-pull) pull=0;; --no-install) install=0;; --no-rebase) rebase=0;; *) echo "apply: unknown flag $a" >&2; exit 2;; esac; done
say() { printf '\n== %s\n' "$*"; }

# ---- 1. Shepherdr branch `local`
[ -d "$SRC/.git" ] || { say "cloning Shepherdr into $SRC"; git clone -q "$UPSTREAM" "$SRC"; }
cd "$SRC"
for d in rebase-merge rebase-apply; do [ -d "$(git rev-parse --git-path $d)" ] && { echo "apply: a rebase/am is in progress in $SRC: finish it (git status), then run apply again" >&2; exit 1; }; done
[ $pull = 1 ] && { say "fetching upstream"; git fetch -q origin; }
if ! git rev-parse -q --verify local >/dev/null; then
  # The patches go on the upstream commit they were made on (they fit there), then the rebase below
  # brings them forward, so a clash with newer upstream shows up the same way as in any update.
  base=$(cut -d' ' -f1 "$KIT/shepherdr/BASE")
  say "making branch local from $(cut -d' ' -f2 "$KIT/shepherdr/BASE") + $(ls "$KIT"/shepherdr/patches/*.patch | wc -l | tr -d ' ') patches"
  git checkout -q -b local "$base"
  git am -q -3 "$KIT"/shepherdr/patches/*.patch || { echo "apply: a patch didn't fit. Fix the files, git add, git am --continue, then run apply again." >&2; exit 1; }
fi
git checkout -q local
if [ $rebase = 1 ]; then
  say "rebasing local onto origin/main ($(git describe --tags origin/main 2>/dev/null))"
  git rebase -q origin/main || { echo "apply: conflicts with the new upstream in $SRC. Fix them, git add, git rebase --continue, then run apply again and bin/export." >&2; exit 1; }
fi
[ $install = 1 ] || exit 0

# ---- 2. Shepherdr checks, install and the installer's two side effects
say "checks"
python3 bin/sync-shared
bun test test/hermes.test.js
say "installing Shepherdr (keeps your keys)"
./install.sh --keys keep --yes
# The installer adds ctrl-k for jump to layout:shepherdr; only cmd-k is wanted.
python3 - "$CFG/keys.json" <<'EOF'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
if d.get("layout:shepherdr", {}).pop("ctrl-k", None) is not None:
    json.dump(d, open(p, "w"), indent=2); print("removed ctrl-k from layout:shepherdr")
EOF
# A tabs-tasks you edited by hand gets the new version beside it as main.js.new: the branch's wins.
n=$CFG/mods/tabs-tasks/main.js.new
[ -f "$n" ] && { cp "$CFG/mods/tabs-tasks/main.js" "$CFG/mods/tabs-tasks/main.js.bak"; cp "$n" "$CFG/mods/tabs-tasks/main.js"; rm -f "$n"; echo "tabs-tasks: took the branch version (old one in main.js.bak)"; }

# ---- 2b. My own mods (this repo's copy wins) and layouts (only added, never overwritten: Herdr saves sizes in them)
say "my mods and layouts"
for m in "$KIT"/herdr/mods/*/; do mkdir -p "$CFG/mods/$(basename "$m")"; cp "$m"* "$CFG/mods/$(basename "$m")/"; herdr-app check "$CFG/mods/$(basename "$m")"; done
mkdir -p "$CFG/layouts"; cp -n "$KIT"/herdr/layouts/*.json "$CFG/layouts/" || true

# ---- 2c. Other people's mods (herdr/third-party/mods.txt): only the missing ones, at the pinned version, plus my patch
grep -v '^#' "$KIT/herdr/third-party/mods.txt" | while read -r name url ref dir patch helper; do
  [ -n "$name" ] || continue
  [ -d "$CFG/mods/$name" ] && { echo "$name: installed, left as is"; continue; }
  say "installing $name ($ref)"
  src="$KIT/.cache/$name"
  [ -d "$src/.git" ] || { git init -q "$src"; git -C "$src" remote add origin "$url"; }
  git -C "$src" fetch -q --depth 1 origin "$ref" && git -C "$src" checkout -q --detach FETCH_HEAD
  cp -R "$src/$dir" "$CFG/mods/$name"
  [ "$patch" != "-" ] && patch -s -p1 -d "$CFG/mods/$name" -i "$KIT/herdr/third-party/$patch"
  if [ "$helper" != "-" ]; then
    # Its release's prebuilt helper for this machine, checked against the release's SHA256SUMS; none: skipped.
    case "$(uname -sm)" in "Darwin arm64") t=aarch64-apple-darwin;; "Darwin x86_64") t=x86_64-apple-darwin;;
      "Linux aarch64") t=aarch64-unknown-linux-gnu;; "Linux x86_64") t=x86_64-unknown-linux-gnu;; *) t=;; esac
    rel="${url%.git}/releases/download/$ref" tmp=$(mktemp -d)
    if [ -n "$t" ] && curl -fsSL -o "$tmp/$helper-$t" "$rel/$helper-$t" && curl -fsSL -o "$tmp/SHA256SUMS" "$rel/SHA256SUMS" \
       && (cd "$tmp" && grep " $helper-$t\$" SHA256SUMS | shasum -a 256 -c -); then
      mkdir -p "$CFG/mods/$name/bin"; install -m 755 "$tmp/$helper-$t" "$CFG/mods/$name/bin/$helper"
    else echo "$name: no checked helper for this machine, skipped"; fi
  fi
  herdr-app check "$CFG/mods/$name"
done
# ⌘⌥G opens Git Grapher beside the focused pane (added only when the key is free).
python3 - "$CFG/keys.json" <<'EOF'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
if "cmd-alt-g" not in d.setdefault("global", {}):
    d["global"]["cmd-alt-g"] = {"command": "pane.split", "args": {"direction": "right", "mod": "git-grapher"}}
    json.dump(d, open(p, "w"), indent=2); print("added cmd-alt-g: Git Grapher beside the focused pane")
EOF

# ---- 3. Hermes plugin and skill
if command -v hermes >/dev/null && [ -d "$HOME/.hermes" ]; then
  say "Hermes plugin and skill"
  mkdir -p "$HOME/.hermes/plugins" "$HOME/.hermes/skills/autonomous-ai-agents"
  cp -R "$KIT/hermes/plugins/herdr-core-status" "$HOME/.hermes/plugins/"
  cp -R "$KIT/hermes/skills/herdr-terminals" "$HOME/.hermes/skills/autonomous-ai-agents/"
  hermes plugins disable herdr-core-status >/dev/null 2>&1 || true
  hermes plugins enable herdr-core-status
else
  say "Hermes not installed: skipped its plugin and skill"
fi
say "done"
