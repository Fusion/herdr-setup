#!/usr/bin/env bash
# Put this setup on a machine, or bring it up to date (run it again any time):
#   1. My own mods and layouts, other people's mods (pinned, with my patches) and the keys.
#   2. The Hermes plugins and skill, and the commands a Hermes Assistant runs unasked, when Hermes is installed.
#   3. The Claude Code subagent hook, when Claude Code is installed.
set -euo pipefail
KIT=$(cd "$(dirname "$0")/.." && pwd)
CFG=${HERDR_APP_HOME:-$HOME/.config/herdr-app}
[ $# = 0 ] || { echo "apply: takes no flags" >&2; exit 2; }
say() { printf '\n== %s\n' "$*"; }

# ---- 1. My own mods (this repo's copy wins) and layouts (only added, never overwritten: Herdr saves sizes in them)
say "my mods and layouts"
for m in "$KIT"/herdr/mods/*/; do mkdir -p "$CFG/mods/$(basename "$m")"; cp "$m"* "$CFG/mods/$(basename "$m")/"; herdr-app check "$CFG/mods/$(basename "$m")"; done
mkdir -p "$CFG/layouts"; cp -n "$KIT"/herdr/layouts/*.json "$CFG/layouts/" || true

# ---- 1b. Other people's mods (herdr/third-party/mods.txt): only the missing ones, at the pinned version, plus my patch
grep -v '^#' "$KIT/herdr/third-party/mods.txt" | while read -r name url ref dir patch helper; do
  [ -n "$name" ] || continue
  [ -d "$CFG/mods/$name" ] && { echo "$name: installed, left as is"; continue; }
  say "installing $name ($ref)"
  src="$KIT/.cache/$name"
  [ -d "$src/.git" ] || { git init -q "$src"; git -C "$src" remote add origin "$url"; }
  git -C "$src" fetch -q --depth 1 origin "$ref" && git -C "$src" checkout -q --detach FETCH_HEAD
  cp -R "$src/$dir" "$CFG/mods/$name"
  [ "$patch" != "-" ] && patch -s -p1 -d "$CFG/mods/$name" -i "$KIT/herdr/third-party/$patch"
  if [ "$helper" != "-" ]; then
    # Its release's prebuilt helper for this machine, checked against the release's SHA256SUMS; none: skipped.
    case "$(uname -sm)" in "Darwin arm64") t=aarch64-apple-darwin;; "Darwin x86_64") t=x86_64-apple-darwin;;
      "Linux aarch64") t=aarch64-unknown-linux-gnu;; "Linux x86_64") t=x86_64-unknown-linux-gnu;; *) t=;; esac
    rel="${url%.git}/releases/download/$ref" tmp=$(mktemp -d)
    if [ -n "$t" ] && curl -fsSL -o "$tmp/$helper-$t" "$rel/$helper-$t" && curl -fsSL -o "$tmp/SHA256SUMS" "$rel/SHA256SUMS" \
       && (cd "$tmp" && grep " $helper-$t\$" SHA256SUMS | shasum -a 256 -c -); then
      mkdir -p "$CFG/mods/$name/bin"; install -m 755 "$tmp/$helper-$t" "$CFG/mods/$name/bin/$helper"
    else echo "$name: no checked helper for this machine, skipped"; fi
  fi
  herdr-app check "$CFG/mods/$name"
done
# ⌘⌥G opens Git Grapher beside the focused pane (added only when the key is free).
python3 - "$CFG/keys.json" <<'EOF'
import json, sys
p = sys.argv[1]
d = json.load(open(p))
if "cmd-alt-g" not in d.setdefault("global", {}):
    d["global"]["cmd-alt-g"] = {"command": "pane.split", "args": {"direction": "right", "mod": "git-grapher"}}
    json.dump(d, open(p, "w"), indent=2); print("added cmd-alt-g: Git Grapher beside the focused pane")
# Layout chris-plain: ⌘K, ⌘⇧K and ⌃⇧K open Herdr's picker there (added only when missing).
if "layout:chris-plain" not in d:
    d["layout:chris-plain"] = {k: "mod.open:picker" for k in ("cmd-k", "cmd-shift-k", "ctrl-shift-k")}
    json.dump(d, open(p, "w"), indent=2); print("added layout:chris-plain keys: picker")
# ⌘⇧H opens hc-pick in every layout: inserts an hc reference into the focused terminal (added only when missing).
if "cmd-shift-h" not in d["global"]:
    d["global"]["cmd-shift-h"] = "mod.open:hc-pick"
    json.dump(d, open(p, "w"), indent=2); print("added cmd-shift-h: hc-pick")
EOF

# ---- 2. Hermes plugins and skill
if command -v hermes >/dev/null && [ -d "$HOME/.hermes" ]; then
  say "Hermes plugin and skill"
  mkdir -p "$HOME/.hermes/plugins" "$HOME/.hermes/skills/autonomous-ai-agents"
  cp -R "$KIT/hermes/plugins/herdr-core-status" "$KIT/hermes/plugins/herdr-panes" "$HOME/.hermes/plugins/"
  cp -R "$KIT/hermes/skills/herdr-terminals" "$HOME/.hermes/skills/autonomous-ai-agents/"
  for p in herdr-core-status herdr-panes; do
    hermes plugins disable $p >/dev/null 2>&1 || true
    hermes plugins enable $p
  done
  echo "herdr-panes loads when the Hermes gateway next restarts"
  # A Hermes Assistant runs Herdr's commands and read-only git without asking (hermes/command_allowlist.txt), through
  # Hermes's own config code, which keeps ${VAR} references in config.yaml as they are.
  py=$HOME/.hermes/hermes-agent/venv/bin/python
  if [ -x "$py" ]; then
    "$py" - "$KIT/hermes/command_allowlist.txt" <<'EOF2'
import os, shutil, sys
sys.path.insert(0, os.path.expanduser("~/.hermes/hermes-agent"))
from hermes_cli.config import load_config, save_config
want = []
for line in open(sys.argv[1]):
    line = line.strip()
    if not line or line.startswith("#"):
        continue
    prog, _, rest = line.partition(" ")
    full = shutil.which(prog) if prog != "git" else None  # agents are told to write herdr-task's full path
    want += [line] + ([f"{full} {rest}".strip()] if full else [])
cfg = load_config()
have = cfg.get("command_allowlist") or []
new = [w for w in dict.fromkeys(want) if w not in have]
if new:
    cfg["command_allowlist"] = [*have, *new]
    save_config(cfg)
print(f"Hermes command_allowlist: {len(new)} added" if new else "Hermes command_allowlist: up to date")
EOF2
  fi
else
  say "Hermes not installed: skipped its plugin and skill"
fi

# ---- 3. Claude Code: one kanban card per subagent (claude/). Only adds: settings.json keeps everything it has.
if [ -d "$HOME/.claude" ]; then
  say "Claude subagent hook"
  cp "$KIT/claude/herdr-subtask-hook.py" "$HOME/.claude/"
  python3 - "$HOME/.claude/settings.json" "$KIT/claude/settings-hooks.json" <<'EOF'
import json, os, shutil, sys
p, add = sys.argv[1], json.load(open(sys.argv[2]))["hooks"]
d = json.load(open(p)) if os.path.exists(p) else {}
h, n = d.setdefault("hooks", {}), 0
for ev, entries in add.items():
    for e in entries:
        if e not in h.setdefault(ev, []):
            h[ev].append(e); n += 1
if n:
    if os.path.exists(p):
        shutil.copy2(p, p + ".bak-herdr-setup")
    json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")
print(f"Claude settings: {n} hook entries added" if n else "Claude settings: up to date")
EOF
fi
say "done"
