{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": { "mod": "workspace-chrome" },
          "size": { "px": 46 },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": { "mod": "spaces" },
              "size": { "weight": 1 },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": { "mod": "agent-cards" },
              "size": { "weight": 1 },
              "min": 90
            }
          ]
        },
        {
          "id": "theeyes",
          "type": "block",
          "content": { "mod": "theeyes" },
          "size": { "px": 140 }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": { "mod": "workspace-chrome", "props": { "footer": true } },
          "size": { "px": 69 }
        }
      ],
      "size": { "px": 391 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "topbar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": { "mod": "tabs" },
              "size": { "weight": 1 },
              "window_drag": true
            },
            {
              "id": "actions",
              "type": "block",
              "content": { "mod": "t3-actions", "props": { "block": "actions" } },
              "size": { "px": 108 },
              "window_drag": true
            },
            {
              "id": "sheepdog",
              "type": "block",
              "content": { "mod": "sheepdog" },
              "size": { "px": 40 }
            }
          ],
          "size": { "px": 42 },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": { "mod": "pane" },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "filetree" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ],
                  "active": "files"
                }
              ],
              "size": { "px": 510 },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": { "mod": "workspace-status" },
          "size": { "px": 28 }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": { "light": "paper", "dark": "ink" },
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "titlebar": "none",
  "traffic_lights": [12, 16]
}
